{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current bash script",
      "type": "shell",
      "command": "bash",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}