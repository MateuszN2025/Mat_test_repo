import tkinter as tk
from tkinter import ttk
from tkinter import messagebox

class FootballTeamApp:
	def __init__(self, root):
		self.root = root
		self.root.title("Football Team Balancer")
		self.entries = []  # Store all entry widgets
		self.create_table()
		self.create_process_button()
		self.create_sum_labels()

	def create_table(self):
		columns = ["id", "Team 1", "Level", "Team 2", "Level", "id"]
		for col, col_name in enumerate(columns):
			label = ttk.Label(self.root, text=col_name, font=("Arial", 10, "bold"), background="#e0e0e0")
			label.grid(row=0, column=col, padx=2, pady=2, sticky="nsew")

		self.entries = []
		for row in range(1, 11):
			row_entries = []
			# id left
			id_label1 = ttk.Label(self.root, text=str(row), background="#f0f0ff")
			id_label1.grid(row=row, column=0, padx=1, pady=1, sticky="nsew")
			row_entries.append(None)
			# Team 1 name
			e1 = ttk.Entry(self.root, width=12)
			e1.grid(row=row, column=1, padx=1, pady=1)
			row_entries.append(e1)
			# Team 1 level
			e2 = ttk.Entry(self.root, width=5)
			e2.grid(row=row, column=2, padx=1, pady=1)
			row_entries.append(e2)
			# Team 2 name
			e3 = ttk.Entry(self.root, width=12)
			e3.grid(row=row, column=3, padx=1, pady=1)
			row_entries.append(e3)
			# Team 2 level
			e4 = ttk.Entry(self.root, width=5)
			e4.grid(row=row, column=4, padx=1, pady=1)
			row_entries.append(e4)
			# id right
			id_label2 = ttk.Label(self.root, text=str(row), background="#f0f0ff")
			id_label2.grid(row=row, column=5, padx=1, pady=1, sticky="nsew")
			row_entries.append(None)
			self.entries.append(row_entries)

	def create_process_button(self):
		self.process_btn = ttk.Button(self.root, text="Balance Teams", command=self.process_teams)
		self.process_btn.grid(row=12, column=0, columnspan=6, pady=10)

	def create_sum_labels(self):
		# Sums and difference labels
		self.sum1_label = ttk.Label(self.root, text="Sum:", font=("Arial", 10, "bold"))
		self.sum1_label.grid(row=11, column=2, sticky="e")
		self.sum2_label = ttk.Label(self.root, text="Sum:", font=("Arial", 10, "bold"))
		self.sum2_label.grid(row=11, column=4, sticky="e")
		self.diff_label = ttk.Label(self.root, text="Difference:", font=("Arial", 10, "bold"))
		self.diff_label.grid(row=11, column=3, sticky="e")
		self.sum1_val = ttk.Label(self.root, text="0.0", font=("Arial", 10, "bold"))
		self.sum1_val.grid(row=12, column=2, sticky="e")
		self.sum2_val = ttk.Label(self.root, text="0.0", font=("Arial", 10, "bold"))
		self.sum2_val.grid(row=12, column=4, sticky="e")
		self.diff_val = ttk.Label(self.root, text="0.0", font=("Arial", 10, "bold"))
		self.diff_val.grid(row=12, column=3, sticky="e")

	def process_teams(self):
		# Placeholder for team balancing logic
		messagebox.showinfo("Info", "Team balancing will be implemented next.")

if __name__ == "__main__":
	root = tk.Tk()
	app = FootballTeamApp(root)
	root.mainloop()
